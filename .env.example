# =============================================================================
# aws-ds — configuration template
#
# Copy this file to `.env` and fill in the values.
# `.env` is NEVER committed (see .gitignore).
#
# On the pair workstations, AWS keys are ABSENT: the EC2 instance profile
# supplies the permissions and the default boto3 resolution chain takes over.
# Static keys are only for the trainer or a machine outside the VPC.
#
# No script reads os.environ directly: everything goes through qc/config.py.
# =============================================================================

# --- Region ------------------------------------------------------------------
# Single source of truth. Hardcoding a region, or relying on the SDK's default
# region, is forbidden.
AWS_REGION=eu-west-3

# --- Credentials (optional, absent on the workstations) -----------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Group identity ------------------------------------------------------------
# Enforced format, validated by regex: ^g[0-9]{2}$  (g01, g02, ...)
TEAM_ID=
PROJECT=aws-ds
OWNER_EMAIL=
# Supplied by `make env-from-tf`. Needed by your team's Terraform module to
# reread the socle's state; this is neither a secret nor an AWS credential.
TF_STATE_BUCKET=

# --- S3 -----------------------------------------------------------------------
# Derived by qc/config.py if left empty: qc-<TEAM_ID>-data-<account suffix>
# The account suffix is required: bucket names must be globally unique.
S3_BUCKET=

# --- SageMaker ----------------------------------------------------------------
SAGEMAKER_ROLE_ARN=
# Logistic regression on ~40 features and 1567 rows: CPU is enough, no GPU.
SAGEMAKER_TRAIN_INSTANCE=ml.m5.large
SAGEMAKER_ENDPOINT_INSTANCE=ml.m5.large
# Derived if left empty: qc-<TEAM_ID>-endpoint
SAGEMAKER_ENDPOINT_NAME=

# --- Bedrock ------------------------------------------------------------------
# Constraint: the model must support TOOL USE via the Converse API.
#
# Value verified by the 2026-07-27 probe in the training account: it's the
# ONLY model actually callable. Nova Lite, Nova Pro and all Anthropic
# models are in the catalog but return AccessDeniedException.
#
# Warning: this is a RAW modelId, not an `eu.*` inference profile. Both
# forms coexist in the region and preflight must accept both — some models
# are only invocable through an `eu.` or `global.` profile.
#
# To re-check after an access change: uv run scripts/discover.py
BEDROCK_MODEL_ID=mistral.mistral-large-2402-v1:0
BEDROCK_MAX_TOKENS=2048

# --- Containers and runtime ----------------------------------------------------
# Derived if left empty: qc-<TEAM_ID>-app
ECR_REPO=
ECS_CLUSTER=
ECS_SERVICE=

# --- Exposure ---------------------------------------------------------------
# SINGLE internal ALB, shared by the whole cohort, created in the socle.
# Path-based routing /<TEAM_ID>/ ; the Streamlit application must therefore
# be started with --server.baseUrlPath=<TEAM_ID> (see decision D12).
ALB_DNS_NAME=
# Degraded mode chosen: internal ALB over plain HTTP. ACM and HTTPS are
# covered as a commented-out demonstration. Leave empty.
ACM_CERT_ARN=

# --- MLflow -------------------------------------------------------------------
# ARN of the SageMaker managed MLflow tracking server, created in the socle.
# One experiment per group, named qc-<TEAM_ID>.
MLFLOW_TRACKING_URI=

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=INFO

# Number of pairs in the cohort. Used by preflight's quota check: on a
# shared account, a quota computed for a single group would make the whole
# training fail the moment everyone deploys at once.
TEAMS_COUNT=6
